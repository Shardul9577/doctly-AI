# Copy to .env.local or .env for local dev.

NEXT_PUBLIC_FRONTEND_URL=http://localhost:8081
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Optional Razorpay publishable key (safe to expose)
# NEXT_PUBLIC_RAZORPAY_API_KEY=

# Optional dev-only: if set, AI consultation calls OpenRouter from the browser
# (the value is still embedded in the client bundle — prefer backend OPEN_ROUTER_KEY).
NEXT_PUBLIC_OPEN_ROUTER_KEY=
