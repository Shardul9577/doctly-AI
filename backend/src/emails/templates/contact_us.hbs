<html>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>New Contact Message - Doctly</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f8fafc;
        color: #333333;
        line-height: 1.6;
        padding: 20px 0;
      }

      .email-wrapper {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
      }

      .header {
        background: #000c63;
        padding: 40px 30px;
        text-align: center;
      }

      .logo {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 8px;
        letter-spacing: 0.5px;
      }

      .header-title {
        font-size: 24px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 4px;
      }

      .header-subtitle {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.8);
        font-weight: 400;
      }

      .content {
        padding: 40px 30px;
        background: #ffffff;
      }

      .notification-badge {
        display: inline-block;
        background: #000c63;
        color: white;
        padding: 6px 12px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 30px;
      }

      .section {
        margin-bottom: 30px;
        background: #f8fafc;
        border-radius: 8px;
        padding: 24px;
        border: 1px solid #e2e8f0;
      }

      .section-header {
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e2e8f0;
      }

      .section-title {
        font-size: 18px;
        font-weight: 600;
        color: #1e293b;
        margin: 0;
      }

      .contact-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .contact-item {
        display: flex;
        align-items: center;
        padding: 16px;
        background: white;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
      }

      .contact-details {
        flex: 1;
      }

      .contact-label {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
      }

      .contact-value {
        font-size: 15px;
        font-weight: 500;
        color: #1e293b;
        word-break: break-word;
      }

      .message-section {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
      }

      .message-content {
        background: white;
        border-radius: 6px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        font-size: 15px;
        line-height: 1.6;
        color: #334155;
        white-space: pre-wrap;
        word-wrap: break-word;
        max-height: 300px;
        overflow-y: auto;
      }

      .timestamp-section {
        text-align: center;
        padding: 20px;
        background: #f8fafc;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
      }

      .timestamp-text {
        font-size: 12px;
        color: #64748b;
        font-weight: 500;
        margin-bottom: 4px;
      }

      .timestamp-value {
        font-size: 14px;
        color: #1e293b;
        font-weight: 500;
      }

      .footer {
        background: #000c63;
        padding: 30px;
        text-align: center;
        color: white;
      }

      .footer-content {
        max-width: 400px;
        margin: 0 auto;
      }

      .footer-title {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 8px;
        color: #ffffff;
      }

      .footer-text {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.8);
        line-height: 1.5;
      }

      .action-button {
        display: inline-block;
        background: #ffffff;
        color: #000c63;
        padding: 10px 20px;
        border-radius: 4px;
        text-decoration: none;
        font-weight: 500;
        font-size: 13px;
        margin-top: 12px;
        transition: all 0.2s ease;
      }

      .action-button:hover {
        background: #f8fafc;
      }

      .divider {
        height: 1px;
        background: #e2e8f0;
        margin: 30px 0;
      }

      /* Responsive Design */
      @media (max-width: 768px) {
        body {
          padding: 10px 0;
        }

        .email-wrapper {
          margin: 0 10px;
          border-radius: 8px;
        }

        .header {
          padding: 30px 20px;
        }

        .header-title {
          font-size: 20px;
        }

        .content {
          padding: 30px 20px;
        }

        .section {
          padding: 20px;
        }

        .contact-grid {
          grid-template-columns: 1fr;
        }

        .contact-item {
          flex-direction: column;
          text-align: center;
        }

        .footer {
          padding: 25px 20px;
        }
      }

      @media (max-width: 480px) {
        .header-title {
          font-size: 18px;
        }

        .section-title {
          font-size: 16px;
        }

        .contact-value {
          font-size: 14px;
        }
      }
    </style>
  </head>
  <body>
    <div class='email-wrapper'>
      <!-- Header Section -->
      <div class='header'>
        <div class='logo'>Doctly</div>
        <h1 class='header-title'>New Contact Message</h1>
        <p class='header-subtitle'>You have received a new inquiry from our
          website</p>
      </div>

      <!-- Content Section -->
      <div class='content'>
        <!-- Contact Information Section -->
        <div class='section'>
          <div class='section-header'>
            <h2 class='section-title'>Contact Information</h2>
          </div>
          <div class='contact-grid'>
            <div class='contact-item'>
              <div class='contact-details'>
                <div class='contact-label'>Full Name</div>
                <div class='contact-value'>{{name}}</div>
              </div>
            </div>
            <div class='contact-item'>
              <div class='contact-details'>
                <div class='contact-label'>Email Address</div>
                <div class='contact-value'>{{email}}</div>
              </div>
            </div>
            <div class='contact-item'>
              <div class='contact-details'>
                <div class='contact-label'>Subject</div>
                <div class='contact-value'>{{subject}}</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Message Section -->
        <div class='section message-section'>
          <div class='section-header'>
            <h2 class='section-title'>Message Content</h2>
          </div>
          <div class='message-content'>{{message}}</div>
        </div>

        <!-- Timestamp Section -->
        <div class='timestamp-section'>
          <div class='timestamp-text'>Message Received On</div>
          <div class='timestamp-value'>{{timestamp}}</div>
        </div>

        <div class='divider'></div>

        <!-- Action Section -->
        <div style='text-align: center; margin-top: 30px;'>
          <p style='color: #64748b; font-size: 13px; margin-bottom: 15px;'>
            Please respond to this inquiry as soon as possible to provide
            excellent customer service.
          </p>
        </div>
      </div>

      <!-- Footer Section -->
      <div class='footer'>
        <div class='footer-content'>
          <div class='footer-title'>Doctly Support Team</div>
          <p class='footer-text'>
            We're here to help! This message was sent from our contact form and
            requires your attention.
          </p>
          <a href='mailto:{{email}}' class='action-button'>Reply to {{name}}</a>
        </div>
      </div>
    </div>
  </body>
</html>